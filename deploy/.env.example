# Produção do beta. Copie para deploy/.env NA VM (nunca versionar) e preencha. Valores com <> são obrigatórios.
APP_VERSION=beta-1
APP_DOMAIN=<beta.seudominio.com.br>
API_DOMAIN=<api.beta.seudominio.com.br>
ACME_EMAIL=<e-mail para avisos do Let's Encrypt>

# Banco (gere uma senha forte: openssl rand -base64 32)
POSTGRES_PASSWORD=<senha>
BACKUP_KEEP_DAYS=7

# Autenticação
SUPABASE_URL=<https://SEU-PROJETO.supabase.co>
SUPABASE_ANON_KEY=<chave pública anon/publishable — vai para o navegador>
SUPABASE_SERVICE_ROLE_KEY=<chave de serviço — SOMENTE aqui no servidor>
CORS_ORIGINS=["https://<beta.seudominio.com.br>"]
FRONTEND_URL=https://<beta.seudominio.com.br>

# Armazenamento S3/R2 (bucket privado)
S3_BUCKET=<bucket>
S3_REGION=auto
S3_ENDPOINT_URL=<https://<conta>.r2.cloudflarestorage.com ou vazio para AWS>
S3_PUBLIC_ENDPOINT_URL=<mesmo endpoint, acessível pelo navegador>
STORAGE_PUBLIC_ORIGIN=<origem do endpoint público, para a CSP do frontend>
S3_ACCESS_KEY_ID=<chave com acesso somente a este bucket>
S3_SECRET_ACCESS_KEY=<segredo>
S3_CORS_ORIGINS=["https://<beta.seudominio.com.br>"]
STORAGE_PROVIDER_NAME=<nome do provedor, para a página de privacidade>
HOSTING_PROVIDER_NAME=<provedor da VM>

# IA
ANTHROPIC_API_KEY=<chave da API da Anthropic>

# Beta fechado
BETA_MODE=true
BETA_ALLOWED_EMAILS=<e-mails convidados, separados por vírgula>
SUPPORT_EMAIL=<e-mail de suporte exibido na página de privacidade>
PLAN_FREE_MONTHLY_MINUTES=180
PLAN_FREE_PROJECTS_PER_DAY=5
# BETA_PERIOD_START=2026-12-01T00:00:00Z
# BETA_PERIOD_END=2026-12-15T00:00:00Z
MAX_ACTIVE_JOBS_PER_USER=1
MAX_REGENERATIONS_PER_DAY=20
LLM_BUDGET_PER_USER_USD=3.0
LLM_BUDGET_TOTAL_USD=40.0

# Worker (valores validados em docs/CAPACIDADE.md)
WHISPER_MODEL=small
WORKER_MEMORY_LIMIT_MB=8192

# Alertas
ALERT_WEBHOOK_URL=<URL do webhook do Slack/Discord — segredo>
ALERT_WEBHOOK_FORMAT=slack
LOG_LEVEL=INFO
