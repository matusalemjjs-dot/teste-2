# Copie para frontend/.env.local. Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredos aqui.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase (Project Settings > API): URL do projeto e chave pública "anon"/"publishable". NUNCA a service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_AUTH_MODE=test   # somente para testes automatizados locais; nunca em produção
# Beta fechado: esconde o cadastro aberto (a API também recusa não convidados)
NEXT_PUBLIC_BETA_MODE=false
