# Copie para backend/.env e ajuste. NUNCA versionar o arquivo .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://autoclip:autoclip@localhost:5432/autoclip

# Supabase Auth (Project Settings > API). O backend apenas VALIDA tokens.
# Não use a service_role key no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Opcional: segredo legado HS256 (Project Settings > API > JWT Settings).
# Se o projeto usar chaves assimétricas (padrão atual), deixe vazio: o JWKS é obtido de SUPABASE_URL.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=["http://localhost:3000"]

# Limites de upload
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=60
MIN_VIDEO_SECONDS=15
UPLOAD_URL_EXPIRES_SECONDS=900

# Object storage privado compatível com S3 (valores do RustFS do docker-compose).
# Em produção (AWS S3/R2), use credenciais com acesso apenas a este bucket.
S3_BUCKET=autoclip-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
# Endereço que o NAVEGADOR usa para enviar o arquivo (pode diferir do endpoint interno).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=autoclip
S3_SECRET_ACCESS_KEY=autoclip-dev-secret
S3_FORCE_PATH_STYLE=true
# Origens do frontend autorizadas a enviar arquivos direto ao bucket (aplicado por: python -m app.storage_setup)
S3_CORS_ORIGINS=["http://localhost:3000"]

# FFmpeg/FFprobe (no Windows, informe o caminho completo se não estiverem no PATH)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
PROBE_TIMEOUT_SECONDS=60

# Fila e worker
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=autoclip
JOB_TIMEOUT_SECONDS=3600
MAX_PROCESS_ATTEMPTS=3
# WORKER_TMP_DIR=          # padrão: pasta temporária do sistema + /autoclip
WORKER_MEMORY_LIMIT_MB=8192        # memória VIRTUAL por job; 4096 impede vídeos de 60 min (docs/CAPACIDADE.md)
WORKER_CPU_LIMIT_SECONDS=7200
WORKER_MIN_FREE_DISK_MB=1024
WORKER_TMP_MAX_AGE_HOURS=6
HEARTBEAT_INTERVAL_SECONDS=30
STALE_HEARTBEAT_SECONDS=600         # sem sinal de vida por 10 min => worker considerado morto
QUEUE_RECONCILE_GRACE_SECONDS=120
MAX_REQUEUES=3
MAINTENANCE_INTERVAL_SECONDS=300    # python -m app.worker.maintenance --loop
FFMPEG_THREADS=2

# Transcrição: faster_whisper (local, padrão) ou openai (serviço externo compatível)
TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_TIMEOUT_SECONDS=3600
# tiny | base | small | medium | large-v3. "small" equilibra qualidade e custo em CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=5
# WHISPER_MODEL_DIR=        # cache dos modelos (padrão: cache do Hugging Face)
# Somente se TRANSCRIPTION_PROVIDER=openai:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Análise inteligente (Claude via API da Anthropic, saída estruturada em JSON Schema)
ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=       # vazio = API oficial
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium           # low | medium | high | xhigh | max
LLM_FALLBACKS=default       # "default": se o modelo recusar, o servidor tenta outro modelo; "off" desativa
LLM_TIMEOUT_SECONDS=300
LLM_MAX_WINDOWS=200
LLM_WINDOWS_PER_REQUEST=40
LLM_INPUT_PRICE_PER_MTOK=4.0    # USD por milhão de tokens (estimativa interna de custo)
LLM_OUTPUT_PRICE_PER_MTOK=20.0
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
MAX_CLIPS=10

# Renderização dos cortes
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_DEFAULT_LAYOUT=center_crop   # center_crop | blur_background
RENDER_PRESET=veryfast              # preset do libx264 (ultrafast..veryslow)
RENDER_CRF=21
RENDER_AUDIO_BITRATE=128k
RENDER_TIMEOUT_SECONDS=900
RENDER_SUBTITLES=true
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_SIZE=80
# SUBTITLE_FONTS_DIR=               # pasta com fontes extras (opcional)
THUMBNAIL_WIDTH=540
DOWNLOAD_URL_EXPIRES_SECONDS=300

# Consumo, cotas e limite de requisições
QUOTAS_ENABLED=true
PLAN_FREE_MONTHLY_MINUTES=60        # aplicado a novas assinaturas (as existentes mantêm seus valores)
PLAN_FREE_PROJECTS_PER_DAY=10
COST_PER_PROCESSED_MINUTE_USD=0.0   # custo interno estimado de infraestrutura (LLM é medido por tokens)
COST_PER_RENDER_MINUTE_USD=0.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=120              # requisições por usuário por janela
RATE_LIMIT_EXPENSIVE=20             # upload-url, finalize-upload, process, regenerate, download-url

# Retenção e privacidade (LGPD) — executada pela manutenção (--loop) a cada RETENTION_INTERVAL_HOURS
RETENTION_ENABLED=true
RETENTION_SOURCE_DAYS=7             # vídeo original, transcrição e candidatos após a conclusão
RETENTION_PROJECT_DAYS=30           # projeto inteiro (cortes incluídos)
RETENTION_ABANDONED_HOURS=24        # projeto criado sem vídeo
RETENTION_ORPHAN_HOURS=24           # arquivo no storage sem registro no banco
RETENTION_ERROR_DETAIL_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_INTERVAL_HOURS=24
# Exclusão de conta: chave de serviço do Supabase SOMENTE no backend (nunca no frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Página "Como tratamos seus dados"
SUPPORT_EMAIL=
STORAGE_PROVIDER_NAME=a definir
HOSTING_PROVIDER_NAME=a definir

# Beta fechado
BETA_MODE=false                     # true: só e-mails convidados usam a API
BETA_ALLOWED_EMAILS=                # e-mails separados por vírgula (convites também via python -m app.admin)
# BETA_PERIOD_START=2026-12-01T00:00:00Z   # período da cota no beta (opcional; padrão: mês civil)
# BETA_PERIOD_END=2026-12-15T00:00:00Z
MAX_ACTIVE_JOBS_PER_USER=1          # processamentos simultâneos por usuário (0 = sem limite)
MAX_REGENERATIONS_PER_DAY=20
LLM_RESERVE_USD_PER_MINUTE=0.015    # reserva estimada de IA por minuto de vídeo (recalibrar com custo real)
LLM_BUDGET_PER_USER_USD=3.0         # teto de custo de IA por usuário no período (0 desativa)
LLM_BUDGET_TOTAL_USD=40.0           # teto de custo de IA de todo o beta (0 desativa)
FRONTEND_URL=http://localhost:3000  # destino do link de convite (/redefinir-senha)

# Monitoramento e alertas (avaliados pela manutenção --loop a cada MAINTENANCE_INTERVAL_SECONDS)
ALERT_WEBHOOK_URL=                  # URL do webhook (Slack, Discord ou próprio) — é um segredo
ALERT_WEBHOOK_FORMAT=slack          # slack | discord | json
ALERT_REPEAT_MINUTES=60             # o mesmo alerta não é reenviado antes disso
ALERT_FAILURES_PER_HOUR=3
ALERT_QUEUE_WAIT_MINUTES=15
ALERT_BUDGET_FRACTION=0.8           # alerta quando o custo de IA (com reservas) passar de 80% do teto total
DAILY_REPORT_ENABLED=true           # relatório diário (sem dados pessoais) no mesmo webhook
DAILY_REPORT_INTERVAL_HOURS=24
CLIENT_ERRORS_PER_MINUTE=30         # por IP, para /api/v1/client-errors e /api/v1/csp-report
