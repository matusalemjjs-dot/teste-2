# Copie para backend/.env e ajuste. NUNCA versionar o arquivo .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://autoclip:autoclip@localhost:5432/autoclip

# Supabase Auth (Project Settings > API). O backend apenas VALIDA tokens.
# Não use a service_role key no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Opcional: segredo legado HS256 (Project Settings > API > JWT Settings).
# Se o projeto usar chaves assimétricas (padrão atual), deixe vazio: o JWKS é obtido de SUPABASE_URL.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=["http://localhost:3000"]

# Limites de upload
MAX_UPLOAD_MB=2048
MAX_VIDEO_MINUTES=60
MIN_VIDEO_SECONDS=15
UPLOAD_URL_EXPIRES_SECONDS=900

# Object storage privado compatível com S3 (valores do MinIO do docker-compose).
# Em produção (AWS S3/R2), use credenciais com acesso apenas a este bucket.
S3_BUCKET=autoclip-media
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
# Endereço que o NAVEGADOR usa para enviar o arquivo (pode diferir do endpoint interno).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=autoclip
S3_SECRET_ACCESS_KEY=autoclip-dev-secret
S3_FORCE_PATH_STYLE=true

# FFmpeg/FFprobe (no Windows, informe o caminho completo se não estiverem no PATH)
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
PROBE_TIMEOUT_SECONDS=60

# Fila e worker
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=autoclip
JOB_TIMEOUT_SECONDS=3600
MAX_PROCESS_ATTEMPTS=3
# WORKER_TMP_DIR=          # padrão: pasta temporária do sistema + /autoclip
WORKER_MEMORY_LIMIT_MB=4096
WORKER_CPU_LIMIT_SECONDS=7200
WORKER_MIN_FREE_DISK_MB=1024
WORKER_TMP_MAX_AGE_HOURS=6
STALE_JOB_GRACE_SECONDS=300
FFMPEG_THREADS=2

# Transcrição: faster_whisper (local, padrão) ou openai (serviço externo compatível)
TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_TIMEOUT_SECONDS=3600
# tiny | base | small | medium | large-v3. "small" equilibra qualidade e custo em CPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=5
# WHISPER_MODEL_DIR=        # cache dos modelos (padrão: cache do Hugging Face)
# Somente se TRANSCRIPTION_PROVIDER=openai:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Análise inteligente (Claude via API da Anthropic, saída estruturada em JSON Schema)
ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=       # vazio = API oficial
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium           # low | medium | high | xhigh | max
LLM_FALLBACKS=default       # "default": se o modelo recusar, o servidor tenta outro modelo; "off" desativa
LLM_TIMEOUT_SECONDS=300
LLM_MAX_WINDOWS=200
LLM_WINDOWS_PER_REQUEST=40
LLM_INPUT_PRICE_PER_MTOK=4.0    # USD por milhão de tokens (estimativa interna de custo)
LLM_OUTPUT_PRICE_PER_MTOK=20.0
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
MAX_CLIPS=10

# Renderização dos cortes
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_DEFAULT_LAYOUT=center_crop   # center_crop | blur_background
RENDER_PRESET=veryfast              # preset do libx264 (ultrafast..veryslow)
RENDER_CRF=21
RENDER_AUDIO_BITRATE=128k
RENDER_TIMEOUT_SECONDS=900
RENDER_SUBTITLES=true
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_SIZE=80
# SUBTITLE_FONTS_DIR=               # pasta com fontes extras (opcional)
THUMBNAIL_WIDTH=540
DOWNLOAD_URL_EXPIRES_SECONDS=300
